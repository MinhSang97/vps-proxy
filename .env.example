# user:pass cho HTTP proxy. Change this.
PROXY_AUTH=user:pass
HTTP_ADDR=:8080

# Ghi log ra file (van in ra man hinh). De trong thi chi in ra man hinh.
LOG_FILE=proxy.log

# Token ngrok, lay tai https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=

# Noi ghi hex cua goi tin. De trong: khong bat goi tin.
#   -       ghi thang vao LOG_FILE, nam canh cac dong log ket noi
#   mongo   ghi thanh ban ghi trong MongoDB. Voi tunnel TCP, proxy con giai ma
#           luong Ngoc Rong ngay luc chay va luu them moi tin 1 dong
#           (kind=message: dir, cmd + ten, data da giai ma) ben canh byte tho.
#   <thumuc> moi ket noi mot file rieng trong thu muc do
DUMP_DIR=mongo

# MongoDB nhan log. De trong thi khong dung mongo.
# make up tu dung container nay, khong can cai gi them.
# Neu khong noi duoc toi mongo, proxy van chay, log quay ve ghi file.
# Deploy len VPS khong co mongo thi de trong dong nay va dat DUMP_DIR=-
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=vps_proxy
MONGO_COLL=logs

# User va mat khau de rieng, khong nhet vao MONGO_URI.
# Mat khau co ky tu @ : / ? # ma nhet vao URI thi phai ma hoa percent,
# sai mot cai la Atlas bao "authentication failed" giong het sai mat khau.
# De trong neu mongo khong can dang nhap (vi du container local).
MONGO_USERNAME=
MONGO_PASS=

# Phien ban client cho viec giai ma Ngoc Rong (2.4.2 tro len). Client kem theo
# la 2.4.7 nen mac dinh bat. Dat NRO_LONG=0 neu dung client cu hon.
NRO_LONG=1

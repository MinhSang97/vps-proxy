# user:pass cho HTTP proxy. Change this.
PROXY_AUTH=user:pass
HTTP_ADDR=:8080

# Ghi log ra file (van in ra man hinh). De trong thi chi in ra man hinh.
LOG_FILE=proxy.log

# Token ngrok, lay tai https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=

# Noi ghi hex cua goi tin. De trong: khong bat goi tin.
#   -       ghi thang vao LOG_FILE, nam canh cac dong log ket noi
#   mongo   ghi thanh ban ghi trong MongoDB, doc lai bang ./dumpread
#   <thumuc> moi ket noi mot file rieng trong thu muc do
DUMP_DIR=mongo

# MongoDB nhan log. De trong thi khong dung mongo.
# make up tu dung container nay, khong can cai gi them.
# Neu khong noi duoc toi mongo, proxy van chay, log quay ve ghi file.
# Deploy len VPS khong co mongo thi de trong dong nay va dat DUMP_DIR=-
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=vps_proxy
MONGO_COLL=logs
